meta {
  name: 03 Login (guarda el token)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "youri@correo.com",
    "password": "123456"
  } 
}

vars:post-response {
  token: res.body.token
}

assert {
  res.status: eq 200
}
