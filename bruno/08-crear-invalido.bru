meta {
  name: 08 Crear producto con datos invalidos
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/productos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "",
    "precio": -5,
    "stock": 3
  }
}

assert {
  res.status: eq 400
}